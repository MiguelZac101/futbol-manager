// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Usuario local, espejo del usuario de Clerk ---
model User {
  id       String  @id @default(cuid())
  clerkId  String  @unique
  name     String
  email    String  @unique
  imageUrl String?

  tournaments Tournament[]
  venues      Venue[]
  referees    Referee[]
}

enum TournamentStatus {
  UPCOMING
  IN_PROGRESS
  FINISHED
}

// El orden de quién juega primero siempre se basa en PUNTOS (más puntos = juega
// más temprano) — eso es fijo. Este campo define solo el CRITERIO DE DESEMPATE
// cuando dos o más equipos empatan en puntos.
enum TiebreakerCriteria {
  GOALS_FOR // más goles a favor (criterio por defecto)
  GOAL_DIFFERENCE // diferencia de goles (a favor - en contra)
}

model Tournament {
  id                 String             @id @default(cuid())
  name               String
  imageUrl           String?
  status             TournamentStatus   @default(UPCOMING)
  tiebreakerCriteria TiebreakerCriteria @default(GOALS_FOR)
  startDate          DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organizerId String
  organizer   User   @relation(fields: [organizerId], references: [id])

  teams  Team[]
  fechas Fecha[]
}

// --- Cancha/campo (reutilizable entre torneos del mismo organizador) ---
model Venue {
  id       String  @id @default(cuid())
  name     String
  address  String
  imageUrl String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  matches Match[]
}

// --- Árbitro (reutilizable entre torneos del mismo organizador) ---
model Referee {
  id       String  @id @default(cuid())
  name     String
  imageUrl String?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  matches Match[]
}

// --- Equipo participante ---
model Team {
  id        String   @id @default(cuid())
  name      String
  imageUrl  String? // logo/insignia
  createdAt DateTime @default(now())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  players      Player[]
  matchesAsOne Match[]  @relation("TeamOne")
  matchesAsTwo Match[]  @relation("TeamTwo")
}

// --- Jugador de un equipo ---
model Player {
  id       String  @id @default(cuid())
  name     String
  dni      String
  photoUrl String?

  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, dni])
}

enum FechaGenerationMethod {
  RANDOM
  STANDINGS
}

enum FechaStatus {
  OPEN
  CLOSED
}

// --- Fecha/Jornada del fixture ---
model Fecha {
  id               String                @id @default(cuid())
  number           Int
  date             DateTime?
  status           FechaStatus           @default(OPEN)
  generationMethod FechaGenerationMethod
  createdAt        DateTime              @default(now())

  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)

  matches Match[]

  @@unique([tournamentId, number])
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

// --- Partido único entre 2 equipos (sin local/visitante) ---
model Match {
  id           String      @id @default(cuid())
  status       MatchStatus @default(SCHEDULED)
  slot         Int // orden dentro de la fecha: 1 = juega primero, 2 = segundo, etc.
  teamOneScore Int         @default(0)
  teamTwoScore Int         @default(0)
  wasSwapped   Boolean     @default(false)

  fechaId String
  fecha   Fecha  @relation(fields: [fechaId], references: [id], onDelete: Cascade)

  teamOneId String
  teamOne   Team   @relation("TeamOne", fields: [teamOneId], references: [id])

  teamTwoId String
  teamTwo   Team   @relation("TeamTwo", fields: [teamTwoId], references: [id])

  venueId String?
  venue   Venue?  @relation(fields: [venueId], references: [id])

  refereeId String?
  referee   Referee? @relation(fields: [refereeId], references: [id])

  @@unique([fechaId, slot])
}
